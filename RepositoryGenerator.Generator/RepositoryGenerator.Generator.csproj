<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>14.0</LangVersion>
		<Nullable>enable</Nullable>
		<IsRoslynComponent>true</IsRoslynComponent>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
	</PropertyGroup>

	<PropertyGroup>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Version>0.0.2</Version>
		<AssemblyVersion>$(Version).0</AssemblyVersion>
		<AssemblyFileVersion>$(Version).0</AssemblyFileVersion>
		<Authors>Christian</Authors>
		<Description>Exam project to generate Repository pattern</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\RepositoryGenerator.Library\RepositoryGenerator.Library.csproj"
		                  ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(OutputPath)\$(AssemblyName).dll"
		      Pack="true"
		      PackagePath="analyzers/dotnet/cs"
		      Visible="false" />

		<None Include="..\RepositoryGenerator.Library\bin\$(Configuration)\netstandard2.0\RepositoryGenerator.Library.dll"
		      Pack="true"
		      PackagePath="analyzers/dotnet/cs"
		      Visible="false" />
		<None Include="..\RepositoryGenerator.Library\bin\$(Configuration)\netstandard2.0\RepositoryGenerator.Library.dll"
				  Pack="true"
				  PackagePath="lib/netstandard2.0"
				  Visible="false" />

	</ItemGroup>

</Project>